{
  "name": "dsh-workspace-hud",
  "version": "1.4.1",
  "description": "DSH-资源统计弹窗 — pinned workspace resource HUD for DeepSeek Harness: files, balance, tokens, cost.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "hud",
    "tokens",
    "usage",
    "cost",
    "pricing",
    "balance",
    "workspace"
  ],
  "license": "MIT",
  "author": "LiuProMax",
  "homepage": "https://github.com/LiuProMax/dsh-resource-hud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiuProMax/dsh-resource-hud.git"
  },
  "bugs": {
    "url": "https://github.com/LiuProMax/dsh-resource-hud/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "pricing.json",
    "icon.svg",
    "assets/preview.png",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/cost.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
